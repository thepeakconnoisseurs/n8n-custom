# Copy to .env and fill in your own values. NEVER commit a real .env.
# All values below are placeholders.

# n8n
N8N_HOST=n8n.example.com
GENERIC_TIMEZONE=Asia/Jakarta
# openssl rand -hex 24  — MUST be identical on main/webhook/worker
N8N_ENCRYPTION_KEY=change-me-encryption-key
# openssl rand -hex 24  — shared between n8n instances and task runner sidecars
N8N_RUNNERS_AUTH_TOKEN=change-me-runner-token

# Postgres (app user — see init-postgres.sh for user separation)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-db-password

# Valkey / Redis
REDIS_PASSWORD=change-me-redis-password

# Task runners
N8N_RUNNERS_MAX_CONCURRENCY=5
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=15
